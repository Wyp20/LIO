<launch>
	<arg name="rviz" default="true" />
	<arg name="namespace" default="rvoxelmap_update" />

	<group ns="$(arg namespace)">
		<rosparam command="load" file="$(find rvoxelmap)/config/test.yaml" />
		<param name="save_mem_flag" type="bool" value="true" />
		<param name="mem_file_path" type="string" value="$(find rvoxelmap)/log/map_test/mem_MB_test_update.txt" />
		<param name="save_time_flag" type="bool" value="true" />
		<param name="time_file_path" type="string" value="$(find rvoxelmap)/log/map_test/time_test_update.txt" />
		<param name="time_aver_file_path" type="string" value="$(find rvoxelmap)/log/map_test/time_aver_test_update.txt" />

		<node pkg="rvoxelmap" type="map_update_test" name="test" output="screen" > 
			<!-- * remap point cloud input topic to your rosbag topic -->
			<remap from="/cloud_registered" to="/voxel_map/cloud_registered"/>
		</node>
	</group>

	<!-- * play rosbag --> 
	<!-- <node pkg="rosbag" type="play" name="rosbag" args="/home/xhb/kitti_test.bag  -r 1 "/> -->

	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find rvoxelmap)/rviz_cfg/test_update.rviz" />
	</group>

</launch>
