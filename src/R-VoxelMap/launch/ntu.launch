<launch>
    <arg name="rviz" default="true" />
    <arg name="bag_name" default="ntu" />
    <arg name="result_dir" default="$(find rvoxelmap)/log/tmp" />
    <arg name="config_file" default="$(find rvoxelmap)/config/ntu.yaml" />

    <arg name="ns" default="rvoxelmap" />
    <group ns="$(arg ns)">

    <rosparam command="load" file="$(arg config_file)" />

    <param name="save_tum_flag" type="bool" value="true" />
    <param name="tum_file_path" type="string" value="$(arg result_dir)/tum_rvoxelmap_$(arg bag_name).txt" />
    <param name="save_kitti_flag" type="bool" value="false" />
    <param name="kitti_file_path" type="string" value="$(arg result_dir)/kitti_rvoxelmap_$(arg bag_name).txt" />
    <param name="save_mem_flag" type="bool" value="true" />
    <param name="mem_file_path" type="string" value="$(arg result_dir)/mem_rvoxelmap_$(arg bag_name).txt" />
    <param name="save_time_flag" type="bool" value="true" />
    <param name="time_file_path" type="string" value="$(arg result_dir)/time_rvoxelmap_$(arg bag_name).txt" />
    <param name="time_aver_file_path" type="string" value="$(arg result_dir)/time_aver_rvoxelmap_$(arg bag_name).txt" />

    <node pkg="rvoxelmap" type="voxel_mapping_odom" name="voxel_mapping_odom" output="screen"/>
    <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find rvoxelmap)/rviz_cfg/voxel_mapping.rviz" />
    </group>
    </group>

</launch>