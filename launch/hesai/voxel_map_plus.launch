<launch>
  <arg name="bag_path" default=""/>
  <arg name="rviz" default="true"/>
  <arg name="config" default="$(env LIO_WS)/configs/hesai/voxel_map_plus.yaml"/>
  <rosparam command="load" file="$(arg config)"/>
  <param name="bag_path" value="$(arg bag_path)"/>
  <param name="/voxelMapping/bag_path" value="$(arg bag_path)"/>
  <node pkg="voxel_map_plus" type="voxel_mapping_plus_odom" name="voxelMapping" output="screen"/>
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find voxel_map_plus)/rviz_cfg/voxel_mapping.rviz"/>
  </group>
</launch>
